# ===========================================
# TIMEWEB PRODUCTION ENVIRONMENT VARIABLES
# ===========================================

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=7850144731:AAHeHudyAVljC2J_CR8NLZznqnDHu8ZgLUw

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Application Settings
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-change-this-in-production

# Video Processing Settings
VIDEO_TEMP_DIR=/tmp/videos
VIDEO_MAX_DURATION=10800
VIDEO_MAX_FILE_SIZE=2147483648
VIDEO_OUTPUT_QUALITY=1080p
VIDEO_MAX_CONCURRENT_TASKS=2

# Google Services (Optional)
# Получите credentials.json из Google Cloud Console
GOOGLE_CREDENTIALS_JSON_CONTENT=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_ID=

# Google OAuth (Optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_
# YouTube Cookies (Optional)
# Для скачивания приватных или ограниченных видео
YOUTUBE_COOKIES_CONTENT=

# Celery Settings
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC

# Performance Settings
CELERY_TASK_TIME_LIMIT=28800
CELERY_TASK_SOFT_TIME_LIMIT=28800
CELERY_WORKER_MAX_TASKS_PER_CHILD=10
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ===========================================
# ИНСТРУКЦИИ ПО ЗАПОЛНЕНИЮ:
# ===========================================

# 1. TELEGRAM_BOT_TOKEN:
#    - Создайте бота через @BotFather в Telegram
#    - Скопируйте токен сюда

# 2. GOOGLE_CREDENTIALS_JSON_CONTENT:
#    - Создайте проект в Google Cloud Console
#    - Включите Google Drive API и Google Sheets API
#    - Создайте Service Account
#    - Скачайте JSON файл с ключами
#    - Скопируйте ВЕСЬ содержимое JSON файла в одну строку

# 3. GOOGLE_DRIVE_FOLDER_ID:
#    - Создайте папку в Google Drive
#    - Откройте папку, скопируйте ID из URL
#    - Дайте доступ Service Account к этой папке

# 4. YOUTUBE_COOKIES_CONTENT:
#    - Установите расширение "cookies.txt" в браузере
#    - Войдите в YouTube
#    - Экспортируйте cookies в формате Netscape
#    - Скопируйте содержимое файла сюда